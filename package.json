{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs",
    "dev:web-only": "next dev",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "start:web": "next start",
    "start:worker": "node worker.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "test:migrations": "node scripts/check-migrations.mjs",
    "test:focus": "node scripts/check-test-focus.mjs",
    "test:migrations:integration": "node scripts/test-migrations-integration.mjs",
    "test:schema-readiness:integration": "node scripts/test-schema-readiness-integration.mjs",
    "test:publication-quarantine:integration": "node scripts/test-publication-quarantine-integration.mjs",
    "test:autopilot-confirmation:integration": "node scripts/test-autopilot-confirmation-integration.mjs",
    "test:semantic-publication:integration": "node scripts/test-semantic-publication-integration.mjs",
    "test:ai-orchestration:integration": "vitest run --config vitest.integration.config.ts src/e2e/ai-orchestration.integration.ts",
    "test:audience-delivery:integration": "vitest run --config vitest.integration.config.ts src/e2e/audience-delivery.integration.ts",
    "test:telegram-sandbox": "node --env-file-if-exists=.env.local scripts/telegram-sandbox-smoke.mjs",
    "test:deployment-smoke": "node --env-file-if-exists=.env.local scripts/deployment-smoke.mjs",
    "test:publication-operation:integration": "vitest run --config vitest.integration.config.ts src/e2e/publication-operation.integration.ts",
    "test:publication-lifecycle:integration": "vitest run --config vitest.integration.config.ts src/e2e/publication-lifecycle.integration.ts",
    "test:project-collaboration:integration": "vitest run --config vitest.integration.config.ts src/e2e/project-collaboration.integration.ts",
    "test:tracking-lifecycle:integration": "vitest run --config vitest.integration.config.ts src/e2e/tracking-lifecycle.integration.ts",
    "test:registration:integration": "vitest run --config vitest.integration.config.ts src/e2e/registration.integration.ts",
    "test:password-recovery:integration": "vitest run --config vitest.integration.config.ts src/e2e/password-recovery.integration.ts",
    "test:contracts": "vitest run src/e2e/critical-journeys.test.ts",
    "test:e2e:real": "node scripts/test-e2e-real.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "tokens:reencrypt": "node --env-file-if-exists=.env.local scripts/reencrypt-token-envelopes.mjs",
    "media:cleanup-orphans": "node --env-file-if-exists=.env.local scripts/cleanup-media-orphans.mjs",
    "worker": "node --env-file=.env.local worker.mjs",
    "worker:site-analysis": "node --env-file=.env.local scripts/site-analysis-worker.mjs",
    "worker:media": "AURORA_WORKER_MODE=media node --env-file=.env.local worker.mjs",
    "worker:publication": "AURORA_WORKER_MODE=publication node --env-file=.env.local worker.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@js-temporal/polyfill": "^0.5.1",
    "bullmq": "^5.80.3",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "next": "16.2.12",
    "pdfkit": "^0.17.2",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright-core": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "next": {
      "postcss": "8.5.26",
      "sharp": "0.35.3"
    }
  }
}
