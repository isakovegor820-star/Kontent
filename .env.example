# ============================================================================
# Аврора — переменные окружения (секреты). Шаг Д.1.
#
# Это ОБРАЗЕЦ. Скопируй его в файл .env.local и впиши свои значения:
#     cp .env.example .env.local
# .env.local в git не попадает — секреты остаются только у тебя.
#
# На Vercel эти же три строки вставляются в Settings → Environment Variables.
# В коде секретов нет — только здесь.
# ============================================================================

# 1) Строка подключения к базе Neon (PostgreSQL).
#    Где взять: neon.tech → твой проект → Connection string → скопировать.
#    Выглядит так: postgresql://user:пароль@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=

# 2) Токен Telegram-бота от @BotFather.
#    Где взять: написать @BotFather → /newbot → придумать имя → он пришлёт токен.
#    Выглядит так: 1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TG_BOT_TOKEN=

# 3) Твой личный chat_id — куда бот шлёт заявки.
#    Где взять: 1) напиши что-нибудь своему боту в Telegram;
#               2) открой в браузере https://api.telegram.org/bot<ТОКЕН>/getUpdates
#               3) найди "chat":{"id": 123456789 ...} — это число и есть chat_id.
TG_CHAT_ID=

# ============================ Д.2 — вход ============================

# 4) Почтовый сервис для кодов входа (Resend). Пусто → дев-режим: код виден на экране,
#    без реальной отправки. Заводится на деплое.
EMAIL_API_KEY=
# Адрес отправителя (нужен подтверждённый домен на Resend). По умолчанию — тестовый resend.dev.
# EMAIL_FROM=Аврора <no-reply@твойдомен.рф>

# 5) VK ID — приложение с dev.vk.com (то же, что будет постить в VK). Пусто → вход через VK
#    отвечает «не настроено». Заводится на деплое.
VK_APP_ID=
VK_APP_SECRET=

# ============================ Д.8 — ИИ ============================

# Локальный движок (по умолчанию): установи Ollama и выполни `ollama pull hermes3`.
# OLLAMA_URL=http://127.0.0.1:11434
# AI_MODEL=hermes3

# Облачные движки используют отдельные ключи. Старый AI_API_KEY поддерживается только как
# совместимый псевдоним OPENAI_API_KEY.
OPENAI_API_KEY=
# OPENAI_API_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Единый ключ NavyAI для моделей в селекторе ИИ-студии:
# DeepSeek V4 Pro/Flash, GPT-5.4, Qwen 3.6 27B и MiniMax M3.
NAVYAI_API_KEY=
# NAVYAI_API_URL=https://api.navy/v1

# Реальные изображения и видео используют тот же NavyAI-ключ, но отдельные лимиты.
# Worker обязан быть запущен: npm run dev поднимает web + worker вместе.
# Если основной worker уже работает на другом сервере, локально запускай только: npm run worker:media
# MEDIA_GENERATION_ENABLED=true
# MEDIA_IMAGE_DAILY_LIMIT=10
# MEDIA_VIDEO_DAILY_LIMIT=3
# MEDIA_IMAGE_MAX_BYTES=26214400
# MEDIA_VIDEO_MAX_BYTES=188743680

# Фоновые служебные задачи по умолчанию используют OpenAI при наличии ключа, иначе Ollama.
# Можно зафиксировать: local | openai | claude | gemini | navy-deepseek-pro | navy-deepseek-flash | navy-gpt-5-4 | navy-qwen-3-6 | navy-minimax-m3
# AI_SERVICE_ENGINE=local

# ============================ Волна 2 — зарубежные соцсети ============================
# Подключение YouTube/Instagram/... через OAuth 2.0 («в один клик»). Бесплатно = нативно:
# сами заводим приложения провайдеров и вписываем ключи сюда. Пусто → сеть отвечает
# «не настроена» (кнопка «Подключить» редиректит в настройки с понятной ошибкой).

# 6) Мастер-ключ шифрования токенов (AES-256-GCM). ОБЯЗАТЕЛЕН для VK и OAuth-сетей:
#    без него сервер не сможет зашифровать токен и подключение не сохранится.
#    Сгенерируй: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#    В git не попадает; не держи в том же бэкапе, что и базу.
TOKENS_MASTER_KEY=
# Необязательно: id текущего ключа (для будущей ротации без перешифровки). По умолчанию «1».
# TOKENS_KEY_ID=1

# 7) YouTube (Google Cloud). Console → проект → включить «YouTube Data API v3» →
#    OAuth consent screen (External, scopes: youtube.upload + youtube.readonly) →
#    Credentials → OAuth Client (Web). Authorized redirect URI:
#        https://<твой-домен>/api/channels/oauth/callback?network=youtube
#    Тестовый режим (consent screen = Testing + тестовые пользователи) работает без верификации.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 8) Instagram (Meta for Developers). Приложение + Facebook Login; App Review на
#    instagram_content_publish + pages_manage_posts + pages_read_engagement (1–4 недели).
#    Пользователю нужен Instagram Business/Creator, привязанный к Facebook Page.
#    Redirect URI: https://<твой-домен>/api/channels/oauth/callback?network=instagram
META_APP_ID=
META_APP_SECRET=
